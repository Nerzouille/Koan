{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "video@koan.nerzouille.dev"
    }
  },
  "name": "Koan - video player",
  "version": "1.3",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "<all_urls>"
  ]
}
