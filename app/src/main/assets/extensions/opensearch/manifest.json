{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "opensearch@koan.nerzouille.dev"
    }
  },
  "name": "Koan - page search engines",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
